# Large binary files
*.pdf

# Sensitive local files (never expose to Claude context)
.env
.mcp.json

# Python artifacts
__pycache__/
*.pyc
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Participant workspace
workspace/

# Presentation folder - exclude utility scripts and docs (except README)
presentation/*.sh
presentation/*.py
presentation/*.md
!presentation/README.md
