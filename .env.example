# =============================================================
#  Agentic AI Course — Environment Variables
# =============================================================
#  Copy this file:  cp .env.example .env
#  Then fill in your API keys below.
# =============================================================

# -----------------------------------------------------------
# GitHub Token (All Days) — Pre-provisioned for lab submission
# Permissions: Contents read-only + Issues read/write
# Repos: aiagentic-comp, aiagentic-comp-frontdeskai
# DO NOT share outside the course.
# -----------------------------------------------------------
GITHUB_TOKEN=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

# -----------------------------------------------------------
# Groq API (Days 2-5) — Free tier: ~1,000 req/min, ~250K tokens/min
# Sign up: https://console.groq.com
# -----------------------------------------------------------
GROQ_API_KEY=gsk_your_key_here

# -----------------------------------------------------------
# LangFuse (Day 4) — Session 12 Lab 09 uses LangFuse Cloud
# For Labs 01-08: Use mock mode (local JSON files)
# For Lab 09: Use real LangFuse cloud
# -----------------------------------------------------------
# IMPORTANT: No spaces around = and no quotes around values!
# Correct:   LANGFUSE_SECRET_KEY=sk-lf-your-key
# Wrong:     LANGFUSE_SECRET_KEY = "sk-lf-your-key"

# LangFuse Cloud (get your keys from https://cloud.langfuse.com):
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------
# OpenTelemetry (Day 4) — Console exporter (no collector needed)
# -----------------------------------------------------------
OTEL_SERVICE_NAME=agent-api

# -----------------------------------------------------------
# Ollama (Day 1 only) — Local LLM
# No API key needed; runs on localhost
# -----------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
