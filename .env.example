# =============================================================
#  Agentic AI Course — Environment Variables
# =============================================================
#  Copy this file:  cp .env.example .env
#  Then fill in your API keys below.
# =============================================================

# -----------------------------------------------------------
# Groq API (Days 2-5) — Free tier: 30 req/min, 14,400 req/day
# Sign up: https://console.groq.com
# -----------------------------------------------------------
GROQ_API_KEY=gsk_your_key_here

# -----------------------------------------------------------
# LangFuse (Day 5) — AI observability platform
# Auto-populated by day5-setup.sh (Docker Compose)
# -----------------------------------------------------------
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:8080

# -----------------------------------------------------------
# OpenTelemetry (Day 5) — Metrics/tracing export
# -----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agent-api

# -----------------------------------------------------------
# Ollama (Day 1 only) — Local LLM
# No API key needed; runs on localhost
# -----------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
