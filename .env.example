# =============================================================
#  Agentic AI Course — Environment Variables
# =============================================================
#  Copy this file:  cp .env.example .env
#  Then fill in your API keys below.
# =============================================================

# -----------------------------------------------------------
# Groq API (Days 2-5) — Free tier: 30 req/min, 14,400 req/day
# Sign up: https://console.groq.com
# -----------------------------------------------------------
GROQ_API_KEY=gsk_your_key_here

# -----------------------------------------------------------
# LangFuse (Day 4) — Mock mode for SDK pattern learning
# Uses local JSON files instead of a LangFuse server
# -----------------------------------------------------------
LANGFUSE_SECRET_KEY=sk-lf-mock-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-mock-public-key
LANGFUSE_HOST=http://localhost:8000

# -----------------------------------------------------------
# OpenTelemetry (Day 4) — Console exporter (no collector needed)
# -----------------------------------------------------------
OTEL_SERVICE_NAME=agent-api

# -----------------------------------------------------------
# Ollama (Day 1 only) — Local LLM
# No API key needed; runs on localhost
# -----------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
