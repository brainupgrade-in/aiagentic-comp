# =============================================================
#  Agentic AI Course — Environment Variables
# =============================================================
#  Copy this file:  cp .env.example .env
#  Then fill in your API keys below.
# =============================================================

# -----------------------------------------------------------
# GitHub Token (All Days) — Required for lab submission
# Permissions needed: Issues read/write on aiagentic-comp
# Codespaces: set LAB_SUBMIT_TOKEN as a repo secret (auto-injected)
# Native (Linux/macOS/Windows): instructor provides the token
# -----------------------------------------------------------
GITHUB_TOKEN=ghp_your_lab_submit_token_here

# -----------------------------------------------------------
# Groq API (Days 2-5) — Free tier: ~1,000 req/min, ~250K tokens/min
# Sign up: https://console.groq.com
# -----------------------------------------------------------
GROQ_API_KEY=gsk_your_key_here

# -----------------------------------------------------------
# LangFuse Cloud (Day 4, Session 12) — free tier
#
# Every participant uses their OWN project and keys:
#   1. Sign up free at https://cloud.langfuse.com
#   2. Create a project, then Settings -> API Keys -> Create new API key
#   3. Paste the pk-lf-... and sk-lf-... values below
#
#   Labs 01-08: mock mode (local JSON files) — no keys needed
#   Lab 09:     sends real traces to your own cloud project
# -----------------------------------------------------------
# IMPORTANT: No spaces around = and no quotes around values!
# Correct:   LANGFUSE_SECRET_KEY=sk-lf-your-key
# Wrong:     LANGFUSE_SECRET_KEY = "sk-lf-your-key"

LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------
# OpenTelemetry (Day 4) — Console exporter (no collector needed)
# -----------------------------------------------------------
OTEL_SERVICE_NAME=agent-api

# -----------------------------------------------------------
# Ollama (Day 1 only) — Local LLM
# No API key needed; runs on localhost
# -----------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
