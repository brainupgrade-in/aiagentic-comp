{
  "name": "Agentic AI Course",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",

  // No "hostRequirements" on purpose — Codespaces picks its default machine and
  // participants can bump CPU/RAM/storage themselves from the Codespace's
  // "Change machine type" menu if a day needs more headroom (see CLAUDE.md).

  // No "features" on purpose — the devcontainers/python image already ships
  // common-utils (the vscode user, git, curl, sudo), and every extra feature is
  // re-installed on each container create when there is no prebuild.

  // zstd is the one missing package: Ollama's install.sh unpacks zstd-compressed
  // tarballs and aborts without it, and bookworm ships no zstd. A plain apt line
  // (not the apt-packages feature) keeps the create fast; non-fatal because only
  // Day 1 needs Ollama and scripts/setup.sh installs zstd itself if this fails.
  "onCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq zstd || true",

  // Setup is DELIBERATELY NOT automated, so the container attaches in seconds.
  // Run this once in the container terminal before the first lab (~3-5 min):
  //
  //     source scripts/setup.sh --skip-ollama     # venv + packages + kernel
  //     bash .devcontainer/post-create.sh         # same, plus injects Codespaces secrets into .env
  //
  // Then re-check any time with:
  //
  //     bash scripts/setup.sh --verify            # what's installed / what's missing
  //     bash scripts/setup.sh --kernel-only       # re-register the 'gheware-agentic-ai' kernel
  //
  // Uncomment these two lines to go back to fully automatic (slower) setup:
  // "postCreateCommand": "bash .devcontainer/post-create.sh",
  // "postStartCommand": "bash scripts/setup.sh --kernel-only && bash scripts/setup.sh --verify",

  "customizations": {
    "vscode": {
      // Keep this list in sync with .vscode/extensions.json.
      // github.copilot is intentionally absent — it errors without a Copilot
      // subscription and the course does not depend on it.
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers",
        "redhat.vscode-yaml",
        "mikestead.dotenv",
        "github.vscode-pull-request-github"
      ],
      // Container-only settings. Everything else is shared with native
      // Linux/macOS/Windows participants via .vscode/settings.json.
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  },

  "containerEnv": {
    "PYTHONDONTWRITEBYTECODE": "1"
  },

  "forwardPorts": [
    8000,
    3000,
    11434
  ],

  "portsAttributes": {
    "8000":  { "label": "FastAPI App" },
    "3000":  { "label": "LangFuse Server" },
    "11434": { "label": "Ollama" }
  },

  "remoteUser": "vscode"
}
