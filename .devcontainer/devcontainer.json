{
  "name": "Agentic AI Course",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",

  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false
    }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash scripts/install-jupyter-kernel.sh && bash scripts/day3-setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "jupyter.kernelPicker.type": "default",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "containerEnv": {
    "PYTHONDONTWRITEBYTECODE": "1"
  },

  "forwardPorts": [
    8000,
    3000,
    11434
  ],

  "portsAttributes": {
    "8000":  { "label": "FastAPI App" },
    "3000":  { "label": "LangFuse Server" },
    "11434": { "label": "Ollama" }
  },

  "remoteUser": "vscode"
}
